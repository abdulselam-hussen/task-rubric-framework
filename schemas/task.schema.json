{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task.schema.json",
  "title": "Task",
  "description": "A single evaluation task for an agentic coding system.",
  "type": "object",
  "required": ["id", "version", "name", "description", "user_intent", "milestones", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique kebab-case identifier, e.g. 'fix-null-dereference-001'."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version, e.g. '1.0'."
    },
    "name": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "Full problem statement shown to the agent."
    },
    "user_intent": {
      "type": "string",
      "description": "One-sentence goal from the user's perspective."
    },
    "category": {
      "type": "string",
      "enum": ["debugging", "feature", "refactor", "security", "infrastructure", "maintenance"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "repo_url": {
      "type": "string",
      "pattern": "^(https?://|git@)"
    },
    "repo_ref": {
      "type": "string",
      "default": "main"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered steps the agent should take.",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "description": { "type": "string" },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Binary observable conditions that must all be true for the task to pass.",
      "items": {
        "type": "object",
        "required": ["id", "criterion"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string" },
          "automated": { "type": "boolean", "default": true }
        }
      }
    },
    "hidden_edge_cases": {
      "type": "array",
      "description": "Edge cases not disclosed to the agent; used for scoring depth.",
      "items": {
        "type": "object",
        "required": ["id", "description", "input", "expected"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "input": {},
          "expected": {}
        }
      }
    },
    "setup_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "eval_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "default": 300
    },
    "reference_solution": {
      "type": "string",
      "description": "Path to the reference solution file relative to the task file."
    },
    "rubric": {
      "type": "string",
      "description": "Path to the associated rubric YAML file."
    }
  }
}
